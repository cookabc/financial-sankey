{
  "name": "financial-sankey-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src scripts tests vite.config.js playwright.config.js eslint.config.js",
    "test": "node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "build": "vite build && node scripts/verify-build.mjs",
    "verify:labels": "node scripts/verify-labels.mjs",
    "check": "npm run lint && npm test && npm run build",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui"
  },
  "dependencies": {
    "d3-sankey": "0.12.3",
    "exceljs": "4.4.0",
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "globals": "17.4.0",
    "jsdom": "^30.1.3",
    "vite": "8.3.5"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.1"
}
